PORT=3001
# Orígenes permitidos (separados por coma). En producción: la URL de Vercel.
FRONTEND_URL=https://localhost:5173,http://localhost:5173
# TURN de Cloudflare (Etapa 6). Nunca exponer estas claves en el frontend.
# Dashboard de Cloudflare -> Realtime -> TURN Service -> crear una TURN key.
# Key ID = "TURN Token ID"; API token = el secreto que se muestra una sola vez.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Opcional: duración de las credenciales TURN en segundos (por defecto 86400 = 24 h)
# TURN_TTL_SECONDS=86400
